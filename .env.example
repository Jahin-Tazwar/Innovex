# Copy to .env and fill in. NEVER commit the filled-in file.
# Only the key matching LLM_PROVIDER needs a value.

# groq | openai | stub
# "stub" runs the service with no model: every note degrades to no_op. Useful
# for offline testing of the optimizer, NOT valid for submission.
LLM_PROVIDER=groq

# Leave blank to use the provider default
# (groq -> llama-3.3-70b-versatile, openai -> gpt-4o-mini).
LLM_MODEL=

GROQ_API_KEY=
OPENAI_API_KEY=

# Judge allows 30s per request; stop the model early so there is always time
# left to optimize and answer.
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1
SOLVER_TIMEOUT_SECONDS=10

# Local port. Render/Railway/Fly inject PORT themselves.
PORT=8000

DEBUG=false
